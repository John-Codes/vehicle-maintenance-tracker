---
const TRUST_BADGES = [
  { title: 'Installed by pros', description: 'Certified technicians install and configure every tracker.' },
  { title: 'Proactive maintenance', description: 'We schedule the work before something breaks, not after.' },
  { title: 'One call fixes it', description: 'One number, one team, one invoice — no vendor maze.' },
];
---
<section>
  <div class="wrap">
    <span class="kicker">Boots on the ground</span>
    <h2>Software watches. Pros show up.</h2>
    <p class="lead" style="margin-top:18px;max-width:720px;">
      Software alone watches dashboards. SafePrevent sends an experienced professional
      before something breaks — that is the whole point.
    </p>
    <div style="margin-top:28px;display:flex;gap:24px;flex-wrap:wrap;justify-content:center;">
      {TRUST_BADGES.map((badge) => (
        <div style="flex:1;min-width:180px;">
          <div style="font-weight:700;color:var(--teal);">{badge.title}</div>
          <p class="muted" style="margin-top:4px;font-size:0.95rem;">{badge.description}</p>
        </div>
      ))}
    </div>
    <p class="muted" style="margin-top:24px;text-align:center;">
      Not just proven on a screen — proven on the ground.
    </p>
  </div>
</section>